---
import { SIGNUP_URL, TERMS_URL, PRIVACY_URL, SOCIAL, CONTACT_EMAIL } from '../config';

const columns = [
  {
    heading: 'Product',
    links: [
      { label: 'Features', href: '/#features' },
      { label: 'Pricing', href: '/pricing' },
      { label: 'Integrations', href: '/integrations' },
      { label: 'Security', href: '/security' },
    ],
  },
  {
    heading: 'Solutions',
    links: [
      { label: 'Conference management', href: '/solutions/conference-management-software' },
      { label: 'Registration and ticketing', href: '/solutions/event-registration-software' },
      { label: 'Virtual and hybrid events', href: '/solutions/virtual-and-hybrid-event-software' },
      { label: 'Sponsors and exhibitors', href: '/solutions/sponsor-and-exhibitor-management-software' },
      { label: 'Check-in and badges', href: '/solutions/event-check-in-and-badge-printing' },
      { label: 'Event websites', href: '/solutions/event-website-builder' },
      { label: 'Meetups and workshops', href: '/solutions/meetup-and-workshop-management-software' },
    ],
  },
  {
    heading: 'Company',
    links: [
      { label: 'Why EventLantern', href: '/why' },
      { label: 'Compare platforms', href: '/compare' },
      { label: 'About', href: '/about' },
      { label: 'EventBound is now EventLantern', href: '/eventbound' },
      { label: 'Contact', href: '/contact' },
      { label: 'Planning resources', href: '/resources' },
      { label: 'Start free', href: SIGNUP_URL },
    ],
  },
  {
    heading: 'Legal',
    links: [
      { label: 'Terms', href: TERMS_URL },
      { label: 'Privacy policy', href: PRIVACY_URL },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="on-dark border-t border-ivory/10 bg-ink text-ivory/80">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
    <div class="grid gap-12 md:grid-cols-6">
      <div class="md:col-span-2">
        <a href="/" aria-label="EventLantern home">
          <img src="/logo-reverse.svg" alt="EventLantern" class="h-10 w-auto rounded-sm" width="160" height="40" />
        </a>
        <p class="mt-5 max-w-xs text-sm leading-6">
          One clear view of the whole event. Registration, programming, speakers, sponsors, check-in and reporting, together.
        </p>
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="mt-5 inline-block text-sm font-semibold text-ivory underline decoration-brass underline-offset-4"
        >
          {CONTACT_EMAIL}
        </a>
      </div>

      {
        columns.map((col) => (
          <div>
            <h3 class="font-mono text-xs font-medium text-brass-glow">{col.heading}</h3>
            <ul class="mt-4 space-y-3">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm transition-colors hover:text-white">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-14 flex flex-col gap-2 border-t border-ivory/15 pt-6 text-sm text-ivory/60 sm:flex-row sm:justify-between">
      <p>© {year} EventLantern. All rights reserved.</p>
      {SOCIAL.linkedin && (
        <a
          href={SOCIAL.linkedin}
          aria-label="EventLantern on LinkedIn (opens in a new tab)"
          class="inline-flex min-h-11 min-w-11 items-center justify-center self-start rounded-sm text-ivory/80 transition-colors hover:text-brass-glow sm:self-center"
          rel="noopener noreferrer"
          target="_blank"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
          </svg>
        </a>
      )}
    </div>
  </div>
</footer>
