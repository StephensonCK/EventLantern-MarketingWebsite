---
import Flame from './Flame.astro';
import Embers from './Embers.astro';
import Words from './Words.astro';

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="hero-stage on-dark">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 pb-16 pt-16 sm:px-8 sm:pb-20 sm:pt-24 lg:grid-cols-12">
    <div class="lg:col-span-9">
      <p class="eyebrow hero-enter">{eyebrow}</p>
      <h1 class="display mt-5 max-w-4xl"><Words text={title} /></h1>
      {lede && <p class="lead hero-enter hero-enter-3 mt-7 max-w-2xl">{lede}</p>}
      <div class="hero-enter hero-enter-3 mt-9 flex flex-wrap gap-3 empty:hidden">
        <slot />
      </div>
    </div>
    <div class="relative hidden lg:col-span-3 lg:block" aria-hidden="true">
      <div class="flame-glow absolute -right-10 top-4 h-72 w-72"></div>
      <div class="relative ml-auto mr-6 mt-8 w-fit">
        <Flame class="h-44 w-auto text-ivory" flameOnly />
        <Embers left="50%" top="22%" />
      </div>
    </div>
  </div>
  <div class="hero-rule" aria-hidden="true"></div>
</section>
