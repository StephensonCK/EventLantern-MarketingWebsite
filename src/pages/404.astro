---
import BaseLayout from '../layouts/BaseLayout.astro';
import Flame from '../components/Flame.astro';
import Embers from '../components/Embers.astro';
import Words from '../components/Words.astro';
---

<BaseLayout
  title="Page not found | EventLantern"
  description="The page you are looking for does not exist or has moved."
>
  <section class="hero-stage on-dark">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-5 py-24 sm:px-8 sm:py-32 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <p class="eyebrow hero-enter">404</p>
        <h1 class="display mt-5"><Words text="This page isn't lit." /></h1>
        <p class="lead hero-enter hero-enter-3 mt-7 max-w-xl">
          The page you are looking for does not exist or has moved.
        </p>
        <a href="/" class="btn btn-primary hero-enter hero-enter-3 mt-9">Back to home</a>
      </div>
      <div class="relative hidden lg:col-span-4 lg:block" aria-hidden="true">
        <div class="flame-glow absolute left-1/2 top-1/2 h-[26rem] w-[26rem] -translate-x-1/2 -translate-y-1/2"></div>
        <div class="relative mx-auto w-fit">
          <Flame class="h-72 w-auto text-ivory" />
          <Embers left="55%" top="20%" />
        </div>
      </div>
    </div>
    <div class="hero-rule" aria-hidden="true"></div>
  </section>
</BaseLayout>
