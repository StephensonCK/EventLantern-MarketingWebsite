---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBand from '../components/CtaBand.astro';
import { SIGNUP_URL, APP_URL } from '../config';

const faqs = [
  {
    question: 'Is EventBound the same product as EventLantern?',
    answer:
      'Yes. EventBound is now EventLantern. The name changed; the product, your account, your event data, and your plan did not.',
  },
  {
    question: 'Do I need to do anything with my existing EventBound account?',
    answer:
      'No. Existing accounts, event data, plans, and product access continue as usual. Sign in at app.eventlantern.com as before.',
  },
  {
    question: 'Why did EventBound change its name?',
    answer:
      'The new name and identity better reflect the product: one clear view of the whole event. The product and its purpose are not changing.',
  },
];
---

<BaseLayout
  title="EventBound is now EventLantern | Same Product, New Name"
  description="EventBound is now EventLantern. The same event management platform, account, and data under a new name. Here is what stayed the same and where to sign in."
  breadcrumbs={[{ name: 'EventBound is now EventLantern', href: '/eventbound' }]}
>
  <PageHero
    eyebrow="Formerly EventBound"
    title="EventBound is now EventLantern."
    lede="The name changed. The product, your account, and your data did not."
  >
    <a href={APP_URL} class="btn btn-primary">Sign in</a>
    <a href={SIGNUP_URL} class="btn btn-ghost">Start free</a>
  </PageHero>

  <section class="py-20 sm:py-24">
    <div class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal>
        <h2 class="h-section">What stayed the same</h2>
        <ul class="rule-list mt-8 border-y border-rule">
          <li class="py-5">
            <h3 class="font-semibold">Your account and event data</h3>
            <p class="mt-1 leading-7 text-ink-soft">Existing accounts and event data continue as usual.</p>
          </li>
          <li class="py-5">
            <h3 class="font-semibold">Your plan and pricing</h3>
            <p class="mt-1 leading-7 text-ink-soft">
              Plans carry over. See the current <a href="/pricing" class="link">published pricing</a>.
            </p>
          </li>
          <li class="py-5">
            <h3 class="font-semibold">The product itself</h3>
            <p class="mt-1 leading-7 text-ink-soft">
              The same platform for registration, scheduling, speakers, check-in, sponsors, and analytics. Explore it
              on the <a href="/" class="link">home page</a> or by <a href="/solutions" class="link">solution</a>.
            </p>
          </li>
        </ul>
      </div>
      <div class="lg:col-span-5" data-reveal>
        <h2 class="h-section">What you will notice</h2>
        <p class="lead mt-6">
          The new name and identity appear across the website and product over time. If you are looking for the
          EventBound website, you are in the right place.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-rule py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <h2 class="h-section" data-reveal>Questions, answered.</h2>
      <FaqAccordion items={faqs} />
    </div>
  </section>

  <CtaBand title="Same event platform. Clearer name." subtitle="Sign in to your existing account or start free." />
</BaseLayout>
