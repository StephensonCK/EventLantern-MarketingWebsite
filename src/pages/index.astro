---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBand from '../components/CtaBand.astro';
import BrandLogo from '../components/BrandLogo.astro';
import Words from '../components/Words.astro';
import { Image } from 'astro:assets';
import dashboardShot from '../assets/product/dashboard.png';
import scheduleShot from '../assets/product/schedule.png';
import sponsorsShot from '../assets/product/sponsors.png';
import eventWebsiteShot from '../assets/product/event-website.png';
import type { LogoName } from '../lib/logos';
import { SIGNUP_URL } from '../config';
import { plans, matrix } from '../data/pricing';

const tools: { name: string; logo: LogoName }[] = [
  { name: 'Zoom', logo: 'zoom' },
  { name: 'Microsoft Teams', logo: 'teams' },
  { name: 'HubSpot', logo: 'hubspot' },
  { name: 'Salesforce', logo: 'salesforce' },
  { name: 'Slack', logo: 'slack' },
  { name: 'Twilio', logo: 'twilio' },
  { name: 'Mailchimp', logo: 'mailchimp' },
  { name: 'SendGrid', logo: 'sendgrid' },
  { name: 'Zapier', logo: 'zapier' },
];

const faqs = [
  {
    question: 'What is EventLantern?',
    answer:
      'EventLantern is an event management platform for conferences, workshops, and meetups. It covers registration, ticketing, session scheduling, speaker management, check-in, sponsor and exhibitor portals, analytics, and more, in one connected system. It was previously called EventBound.',
  },
  {
    question: 'Is EventBound the same product?',
    answer:
      'Yes. The name is changing; the product and its purpose are not. Existing accounts, event data, plans, and product access continue as usual. You will see the new name and identity appear across the website and product over time.',
  },
  {
    question: 'Is there a free plan?',
    answer:
      'Yes. The Free plan lets you run one active event with up to 50 attendees, no credit card required. It includes core features like session scheduling, QR check-in, badge printing, and an attendee portal.',
  },
  {
    question: 'Can I run virtual or hybrid events?',
    answer:
      'Yes. EventLantern supports virtual, in-person, and hybrid events on every plan, so you can reach attendees wherever they are.',
  },
  {
    question: 'What integrations are available?',
    answer:
      'Zoom and Microsoft Teams are on every plan. The Professional plan adds HubSpot, Salesforce, Twilio SMS, Slack, Mailchimp, SendGrid, and Zapier. The Integrations page has the details.',
  },
  {
    question: 'How does pricing work?',
    answer:
      'There are three plans: Free ($0), Starter ($49/mo for up to 3 events and 500 attendees each), and Professional ($249/mo for unlimited events and up to 5,000 attendees each). Pricing is published, with no hidden fees.',
  },
  {
    question: 'Is my event data secure?',
    answer:
      'Security is built into the architecture: row-level data isolation, zero-trust access, encrypted portals, full audit trails, and PCI-compliant payments through Stripe. The Security page has the full overview.',
  },
  {
    question: 'Are there extra fees for paid events?',
    answer:
      'The subscription price is all-inclusive. When you sell tickets through Stripe Connect, standard Stripe processing fees (2.9% + $0.30 per card transaction) apply. Those go directly to Stripe. EventLantern adds no markup.',
  },
];

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'EventLantern',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description:
    'Event management software for conferences, workshops, and meetups. Registration, ticketing, check-in, speaker management, sponsor portals, and analytics in one connected system.',
  offers: [
    { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'USD' },
    { '@type': 'Offer', name: 'Starter', price: '49', priceCurrency: 'USD' },
    { '@type': 'Offer', name: 'Professional', price: '249', priceCurrency: 'USD' },
  ],
};
---

<BaseLayout
  title="Event Management Software | EventLantern"
  description="Event management software for conferences, workshops, and meetups: registration, ticketing, scheduling, speakers, sponsors, QR check-in, and analytics in one place. Free plan, published pricing."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(appSchema)} />

  <!-- Hero -->
  <section>
    <div class="hero-stage on-dark">
      <div class="mx-auto max-w-7xl px-5 pb-14 pt-16 sm:px-8 sm:pb-20 sm:pt-24">
        <div class="grid items-end gap-10 lg:grid-cols-[1.3fr_0.7fr] lg:gap-20">
          <div>
            <p class="eyebrow hero-enter">Event management, brought into focus</p>
            <h1 class="display mt-5">
              <Words text="See the whole event." /><br />
              <span class="text-brass-glow"><Words text="Run it as one." start={4} /></span>
            </h1>
          </div>
          <div class="hero-enter hero-enter-3 lg:pb-1">
            <p class="lead max-w-lg">
              Plan the program, welcome attendees, work with partners, and see what happened. One place to run the whole event.
            </p>
            <div class="mt-7 flex flex-wrap items-center gap-5">
              <a href={SIGNUP_URL} class="btn btn-primary">Start free</a>
              <a href="#features" class="link !text-ivory">See it in action <span aria-hidden="true">↗</span></a>
            </div>
            <p class="mt-4 font-mono text-xs text-ivory/65">No credit card · No sales call</p>
          </div>
        </div>

        <figure class="hero-product mt-14 sm:mt-20" data-reveal>
          <div class="hero-product-viewport">
            <Image
              src={dashboardShot}
              alt="Meridian Design Summit dashboard showing registrations, sponsors, exhibitors, and event activity"
              widths={[960, 1440, 2230]}
              sizes="(min-width: 1280px) 1216px, 100vw"
              format="webp"
              class="hero-product-image"
              loading="eager"
            />
          </div>
          <figcaption class="flex flex-wrap justify-between gap-2 px-1 pt-4 font-mono text-xs text-ivory/65">
            <span>Inside EventLantern / Event overview</span>
            <span>Meridian Design Summit · demo event</span>
          </figcaption>
        </figure>
      </div>
      <div class="hero-rule" aria-hidden="true"></div>
    </div>

    <!-- Rebrand notice -->
    <div class="border-y border-rule bg-paper">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-5 gap-y-1 px-5 py-3.5 text-sm sm:px-8">
        <p class="font-mono font-medium text-brass-text">Formerly EventBound</p>
        <p class="text-ink-soft">Same product, accounts, and event data.</p>
        <a href="/eventbound" class="font-semibold text-ink underline decoration-brass underline-offset-4">What changed <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <!-- Point of view -->
  <section class="py-20 sm:py-28">
    <div class="mx-auto grid max-w-7xl items-end gap-8 px-5 sm:px-8 lg:grid-cols-[1fr_auto] lg:gap-20" data-reveal>
      <div class="max-w-3xl">
        <p class="eyebrow">Why EventLantern</p>
        <h2 class="h-section mt-3">The details belong together.</h2>
        <p class="lead mt-5 max-w-2xl">A registration changes the attendee list. A session shapes the schedule. A sponsor needs more than a logo. See the connections without hunting through separate tools.</p>
      </div>
      <a href="/why" class="link mb-2 shrink-0">Why we built it this way <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="scroll-mt-16 border-t border-rule bg-paper py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <SectionHeader
        eyebrow="Inside the platform"
        title="From the first session to the last follow-up."
        subtitle="Real views from a sample event. Each part of the work stays connected."
      />

      <div class="mt-14 space-y-20 sm:mt-20 sm:space-y-28">
        <article class="product-story" data-reveal>
          <div class="product-story-copy">
            <span class="story-index">01 / Program</span>
            <h3 class="mt-4 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">Build a schedule people can follow.</h3>
            <p class="mt-5 text-lg leading-8 text-ink-soft">Map sessions across tracks, rooms, and time slots. Speakers and attendees see the same event taking shape.</p>
            <ul class="story-points mt-7">
              <li>Multi-track agenda</li>
              <li>Speaker profiles</li>
              <li>Session registration</li>
            </ul>
            <a href="/solutions/conference-management-software" class="link mt-8 inline-block">Explore conference management <span aria-hidden="true">↗</span></a>
          </div>
          <figure class="product-story-frame">
            <div class="product-story-screen">
              <Image src={scheduleShot} alt="Multi-track schedule for the Meridian Design Summit with sessions arranged by time and track" widths={[800, 1200, 1666]} sizes="(min-width: 1024px) 760px, 100vw" format="webp" class="block h-auto w-full" loading="lazy" />
            </div>
            <figcaption class="story-caption">Schedule / Meridian Design Summit</figcaption>
          </figure>
        </article>

        <article class="product-story product-story-reverse" data-reveal>
          <div class="product-story-copy">
            <span class="story-index">02 / Partners</span>
            <h3 class="mt-4 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">Give sponsors a clear path from prospect to partner.</h3>
            <p class="mt-5 text-lg leading-8 text-ink-soft">Track conversations, tiers, and deliverables in the same event your team is running. Keep the handoffs visible.</p>
            <ul class="story-points mt-7">
              <li>Sponsor pipeline</li>
              <li>Exhibitor management</li>
              <li>Lead capture</li>
            </ul>
            <a href="/solutions/sponsor-and-exhibitor-management-software" class="link mt-8 inline-block">Explore partner tools <span aria-hidden="true">↗</span></a>
          </div>
          <figure class="product-story-frame">
            <div class="product-story-screen">
              <Image src={sponsorsShot} alt="Sponsor management view showing outreach stages and sponsor tiers for a sample event" widths={[800, 1260]} sizes="(min-width: 1024px) 760px, 100vw" format="webp" class="block h-auto w-full" loading="lazy" />
            </div>
            <figcaption class="story-caption">Sponsor CRM / Meridian Design Summit</figcaption>
          </figure>
        </article>

        <article class="product-story" data-reveal>
          <div class="product-story-copy">
            <span class="story-index">03 / Experience</span>
            <h3 class="mt-4 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">Make the event feel like yours.</h3>
            <p class="mt-5 text-lg leading-8 text-ink-soft">Publish an event website with your identity, schedule, speakers, sponsors, and registration in one place.</p>
            <ul class="story-points mt-7">
              <li>Branded event website</li>
              <li>Registration and ticketing</li>
              <li>Attendee portal</li>
            </ul>
            <a href="/solutions/event-website-builder" class="link mt-8 inline-block">Explore event websites <span aria-hidden="true">↗</span></a>
          </div>
          <figure class="product-story-frame product-story-frame-portrait">
            <Image src={eventWebsiteShot} alt="Sample Meridian Design Summit event website with event information, registration, and speaker section" widths={[720, 1120]} sizes="(min-width: 1024px) 640px, 100vw" format="webp" class="block h-auto w-full" loading="lazy" />
            <figcaption class="story-caption">Public event website / Meridian Design Summit</figcaption>
          </figure>
        </article>
      </div>

      <div class="mt-20 border-t border-rule pt-8 sm:mt-28" data-reveal>
        <p class="eyebrow">The rest of the operation</p>
        <div class="mt-6 grid gap-x-10 gap-y-5 text-base font-medium sm:grid-cols-2 lg:grid-cols-4">
          <p>QR check-in and badges</p>
          <p>Attendee communications</p>
          <p>Virtual and hybrid events</p>
          <p>Reports and analytics</p>
        </div>
        <a href="/solutions" class="link mt-8 inline-block">See all solutions <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <!-- Integrations (after dark) -->
  <section class="on-dark relative overflow-hidden bg-ink py-24 text-ivory sm:py-32">
    <div class="flame-glow pointer-events-none absolute -left-40 -top-40 h-[40rem] w-[40rem] opacity-50" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-5 sm:px-8">
      <div class="max-w-3xl" data-reveal>
        <p class="eyebrow">Integrations</p>
        <h2 class="h-section mt-3">Works with the tools you already run.</h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ivory/75">
          Sync with video, CRM, messaging, email, and automation tools, so event data flows to where your team already works.
        </p>
      </div>
      <a href="/integrations" class="btn btn-ghost mt-10">See every integration</a>
    </div>

    <!-- Kinetic marquee: second run is decorative, so it is hidden from assistive tech. -->
    <div class="marquee relative mt-16 border-y border-ivory/10 py-8" data-reveal>
      <div class="marquee-track">
        {
          [0, 1].map((run) => (
            <ul class="flex shrink-0 items-center gap-14 pr-14" aria-hidden={run === 1 ? 'true' : undefined}>
              {tools.map((tool) => (
                <li class="flex items-center gap-4 whitespace-nowrap">
                  <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-[14px] bg-ivory p-3 sm:h-16 sm:w-16">
                    <BrandLogo name={tool.logo} class="h-full w-full" />
                  </span>
                  <span class="text-2xl font-semibold tracking-tight text-ivory/90 sm:text-4xl">{tool.name}</span>
                </li>
              ))}
              <li class="whitespace-nowrap text-2xl font-semibold tracking-tight text-brass-glow sm:text-4xl">and more</li>
            </ul>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="scroll-mt-16 py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <SectionHeader
        eyebrow="Pricing"
        title="Full capability. Fair terms."
        subtitle="Start free. Move up when your event needs it. Published prices, month to month."
      />

      <div class="mt-14 grid border-y border-rule md:grid-cols-[1fr_1fr_1.35fr] md:divide-x md:divide-rule">
        {
          plans.map((plan, i) => (
            <div
              class:list={['relative flex flex-col p-8 sm:p-10', i > 0 && 'border-t border-rule md:border-t-0', plan.featured && 'bg-paper']}
              data-reveal
              style={`--i:${i}`}
            >
              {plan.featured && (
                <span class="absolute inset-x-0 top-0 h-1 bg-brass" aria-hidden="true" />
              )}
              <h3 class="text-xl font-semibold">{plan.name}</h3>
              <p class="mt-5 font-mono text-5xl font-medium tracking-tight">
                {plan.price}<span class="text-lg text-ink-soft">{plan.period}</span>
              </p>
              <p class="mt-4 font-semibold">{plan.description}</p>
              <p class="mt-1 text-ink-soft">{plan.note}</p>
              <a href={SIGNUP_URL} class:list={['btn mt-8 self-start', plan.featured ? 'btn-primary' : 'btn-ghost']}>
                {plan.price === '$0' ? 'Start free' : `Choose ${plan.name}`}
              </a>
            </div>
          ))
        }
      </div>

      <details class="group mt-14 border-b border-rule pb-4" data-reveal>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-2 text-lg font-semibold [&::-webkit-details-marker]:hidden">
          Compare every feature, plan by plan
          <span class="font-mono text-sm text-brass-text group-open:hidden">Show</span>
          <span class="hidden font-mono text-sm text-brass-text group-open:inline">Hide</span>
        </summary>
        <div class="mt-6 overflow-x-auto">
          <table class="w-full min-w-[560px] text-left text-sm">
            <thead>
              <tr class="border-b-2 border-ink">
                <th scope="col" class="py-3 pr-4 font-semibold">Feature</th>
                <th scope="col" class="px-4 py-3 text-center font-semibold">Free</th>
                <th scope="col" class="px-4 py-3 text-center font-semibold">Starter</th>
                <th scope="col" class="px-4 py-3 text-center font-semibold">Professional</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-rule">
              {
                matrix.map((row) => (
                  <tr>
                    <th scope="row" class="py-3 pr-4 font-medium text-ink-soft">{row.feature}</th>
                    {row.cells.map((cell) => (
                      <td class="px-4 py-3 text-center font-mono text-[0.8rem]">
                        {cell === true ? (
                          <svg class="mx-auto h-4 w-4 text-brass-text" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Included">
                            <path d="M3 8.5l3.2 3L13 4.5" />
                          </svg>
                        ) : cell === false ? (
                          <span class="inline-block h-px w-3 bg-ink/30 align-middle" role="img" aria-label="Not included" />
                        ) : cell === 'link' ? (
                          <a href="/integrations" class="link !font-sans text-xs">Details</a>
                        ) : (
                          cell
                        )}
                      </td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </details>

      <p class="mt-8">
        <a href="/pricing" class="link">See full pricing and plan details</a>
      </p>
      <p class="mt-4 max-w-3xl text-sm leading-6 text-ink-soft">
        Paid registrations are processed through Stripe Connect. Standard Stripe fees of 2.9% + $0.30 per card transaction apply. EventLantern adds no markup on top.
      </p>
    </div>
  </section>

  <!-- Security -->
  <section class="border-y border-rule bg-paper-deep py-24 sm:py-28">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 sm:px-8 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal>
        <p class="eyebrow">Security</p>
        <h2 class="h-section mt-3">Built secure, not bolted on.</h2>
        <p class="lead mt-5 max-w-xl">
          Row-level data isolation, zero-trust architecture, encrypted portals, full audit trails, and PCI-compliant payments.
        </p>
        <a href="/security" class="link mt-8 inline-block">Read the security overview</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <SectionHeader eyebrow="FAQ" title="Questions, answered." />
      <FaqAccordion items={faqs} />
    </div>
  </section>

  <CtaBand
    title="Your whole event is ready to come into view."
    subtitle="Create your first event without a sales call or a credit card."
  />
</BaseLayout>
