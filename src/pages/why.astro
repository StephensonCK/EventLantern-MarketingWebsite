---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import { SIGNUP_URL } from '../config';

const beliefs = [
  {
    title: 'Pricing you can read',
    body: 'Published plans, no per-feature surprises, and no markup on ticket processing. You should know the cost before you start.',
  },
  {
    title: 'Setup in minutes',
    body: 'No mandatory sales call, no onboarding cycle. Sign up, create your event, and start building the agenda.',
  },
  {
    title: 'Clear from the first screen',
    body: 'A long feature list is not useful when the product feels like several systems at once. EventLantern is organized as one logical dashboard.',
  },
];

const approach = [
  { need: 'Setup time', answer: 'Minutes. Start immediately.' },
  { need: 'Pricing', answer: 'Public pricing, no surprises.' },
  { need: 'Free plan', answer: '50 attendees, no credit card.' },
  { need: 'Integrations', answer: 'Zoom and Microsoft Teams on every plan. The rest on Professional.' },
  { need: 'Contract length', answer: 'Month to month, cancel anytime.' },
  { need: 'On a phone', answer: 'Designed to work comfortably on mobile.' },
  { need: 'Support', answer: 'Email on every plan, priority on Professional.' },
  { need: 'Platform fees', answer: 'No EventLantern markup on ticket processing.' },
];

const modern = [
  {
    title: 'Launch in minutes',
    body: 'No implementation consultants. Create your event and start selling tickets the same day.',
  },
  {
    title: 'Everything included',
    body: 'Registration, ticketing, check-in, speaker management, analytics, and integrations live in one system, with plan limits published up front.',
  },
  {
    title: 'Made for how events run now',
    body: 'Fast, mobile-friendly, and intuitive for both organizers and attendees.',
  },
];
---

<BaseLayout
  title="Why EventLantern | The modern event platform alternative"
  description="Full event capability, far less platform. Published pricing, setup in minutes, one connected dashboard, and no markup on ticket processing."
>
  <PageHero
    eyebrow="Why EventLantern"
    title="Full event capability. Far less platform."
    lede="The modern alternative to legacy event platforms: everything your team needs, arranged in one logical dashboard and priced without enterprise bloat."
  >
    <a href={SIGNUP_URL} class="btn btn-primary">Start free</a>
    <a href="/#features" class="btn btn-ghost">See the features</a>
  </PageHero>

  <section class="py-24 sm:py-28">
    <div class="mx-auto grid max-w-7xl gap-14 px-5 sm:px-8 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <p class="eyebrow">What we believe</p>
        <h2 class="h-section mt-3">Powerful software can still be clear, fast, and fairly priced.</h2>
      </div>
      <ul class="rule-list lg:col-span-7">
        {
          beliefs.map((item, i) => (
            <li class="py-7 first:pt-0" data-reveal style={`--i:${i}`}>
              <h3 class="text-xl font-semibold">{item.title}</h3>
              <p class="mt-2 max-w-xl leading-7 text-ink-soft">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-y border-rule bg-paper py-24 sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <SectionHeader eyebrow="In practice" title="How EventLantern works" />
      <dl class="rule-list mt-14 max-w-4xl border-y border-rule">
        {
          approach.map((row, i) => (
            <div class="grid gap-1 py-5 sm:grid-cols-5 sm:gap-6" data-reveal style={`--i:${i % 4}`}>
              <dt class="font-semibold sm:col-span-2">{row.need}</dt>
              <dd class="text-ink-soft sm:col-span-3">{row.answer}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="py-24 sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <SectionHeader eyebrow="Built for modern events" title="Everything you need. Nothing you don't." />
      <div class="mt-14 border-t-2 border-ink">
        {
          modern.map((item, i) => (
            <div class="grid gap-4 border-b border-rule py-10 md:grid-cols-12 md:items-start md:gap-x-8" data-reveal>
              <div class:list={['md:col-span-5', i % 2 === 1 ? 'md:col-start-8' : 'md:col-start-1']}>
                <h3 class="text-2xl font-semibold">{item.title}</h3>
              </div>
              <p
                class:list={[
                  'max-w-md leading-7 text-ink-soft md:col-span-5 md:row-start-1',
                  i % 2 === 1 ? 'md:col-start-1' : 'md:col-start-7',
                ]}
              >
                {item.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    title="Ready to see the difference?"
    subtitle="Try EventLantern free. No credit card, no sales call, no strings attached."
  />
</BaseLayout>
